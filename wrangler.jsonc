{
  // Serves the built site from Cloudflare Workers. Workers Builds runs
  // `npx wrangler deploy`, which reads this file: it runs build.sh to produce
  // dist/, then uploads dist/ as the Worker's static assets. dist/ is
  // gitignored, so it has to be built here rather than committed.
  //
  // `name` must match the Worker in the dashboard — a different name would
  // create a second, empty Worker instead of updating this one.
  "name": "dremmanuelopoku",
  "compatibility_date": "2026-08-20",
  "build": {
    "command": "./build.sh"
  },
  "assets": {
    "directory": "./dist"
  },
  // Declaring the domains here means the deploy creates the custom domain and
  // writes the DNS record itself — the zone is on the same Cloudflare account,
  // so nothing needs doing by hand. www serves the same site; the canonical
  // link in index.html points both at the apex.
  "routes": [
    { "pattern": "thepowerofus.us", "custom_domain": true },
    { "pattern": "www.thepowerofus.us", "custom_domain": true }
  ]
}
